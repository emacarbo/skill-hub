#!/usr/bin/env python3
"""
generate-stubs.py — Generate compact SKILL.md stub files for Claude Code skills.

Each stub is ~200-500 bytes and replaces the full skill file (5-30 KB) in the
context window. When Claude actually needs the full skill content, it reads the
path referenced in the stub.

Usage:
    python generate-stubs.py all
    python generate-stubs.py security-guardian api-design-pro react-development
    python generate-stubs.py all --output-dir /custom/output/dir
    python generate-stubs.py all --source-dir /custom/source/dir
"""

import argparse
import os
import re
import sys
import textwrap
from pathlib import Path

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

DEFAULT_SOURCE_DIR = Path.home() / "dev" / "skill-hub" / "agents" / "general_skills"
DEFAULT_OUTPUT_DIR = Path.home() / ".claude" / "skills"
PLUGINS_DIR = Path.home() / "dev" / "skill-hub" / "plugins"
MAX_DESCRIPTION_CHARS = 1024


def find_plugin_stub_paths(skill_name: str) -> list[Path]:
    """Find all skill-hub plugin locations that already contain this skill.

    Returns paths to <plugin>/skills/<skill_name>/SKILL.md so the regenerated
    stub propagates to every plugin that owns the skill. Without this, plugin
    stubs go stale relative to the full-reference source.
    """
    paths: list[Path] = []
    if not PLUGINS_DIR.exists():
        return paths
    for plugin in PLUGINS_DIR.iterdir():
        if not plugin.is_dir():
            continue
        skill_dir = plugin / "skills" / skill_name
        if skill_dir.exists():
            paths.append(skill_dir / "SKILL.md")
    return paths

# Lines/patterns that indicate a "triggers" or "when to use" section.
TRIGGER_SECTION_PATTERNS = [
    re.compile(r"^triggers\s*:", re.IGNORECASE),           # YAML key
    re.compile(r"^#+\s*(triggers?|when to use|use when|use this skill when)", re.IGNORECASE),  # heading
    re.compile(r"^\*\*(triggers?|when to use)\*\*", re.IGNORECASE),  # bold label
]

# Inline trigger lines (single-line hints like "Triggers: foo, bar").
INLINE_TRIGGER_PATTERNS = [
    re.compile(r"^\*\*triggers?\*\*\s*[:\-]\s*(.+)", re.IGNORECASE),
    re.compile(r"^triggers?\s*[:\-]\s*(.+)", re.IGNORECASE),
]

# YAML frontmatter block.
FRONTMATTER_RE = re.compile(r"^---\s*\n(.*?)\n---\s*\n", re.DOTALL)

# SUMMARY comment block written in several skills.
SUMMARY_COMMENT_RE = re.compile(
    r"<!--\s*SUMMARY\s*\n(.*?)\nEND SUMMARY\s*-->", re.DOTALL
)


# ---------------------------------------------------------------------------
# Parsing helpers
# ---------------------------------------------------------------------------

def parse_frontmatter(text: str) -> dict:
    """Return a dict of scalar/list frontmatter values (simple YAML, no nesting)."""
    match = FRONTMATTER_RE.match(text)
    if not match:
        return {}

    fm: dict = {}
    block = match.group(1)

    # Handle multi-line values introduced by "key: >\n  ..."
    # We'll do a simple state-machine parse rather than pulling in PyYAML.
    current_key = None
    current_value_lines: list[str] = []
    list_mode = False

    def flush():
        nonlocal current_key, current_value_lines, list_mode
        if current_key is None:
            return
        if list_mode:
            fm[current_key] = [v.lstrip("- ").strip() for v in current_value_lines if v.strip()]
        else:
            fm[current_key] = " ".join(current_value_lines).strip()
        current_key = None
        current_value_lines = []
        list_mode = False

    for line in block.splitlines():
        # Top-level key?
        key_match = re.match(r"^(\w[\w\-]*)\s*:\s*(.*)", line)
        if key_match and not line.startswith(" ") and not line.startswith("\t"):
            flush()
            current_key = key_match.group(1).lower()
            rest = key_match.group(2).strip()
            if rest in (">", "|", ""):
                # Multi-line or list follows
                current_value_lines = []
                list_mode = False
            else:
                current_value_lines = [rest]
        elif line.startswith("  - ") or line.startswith("- "):
            # List item
            list_mode = True
            current_value_lines.append(line.strip())
        elif line.startswith("  ") or line.startswith("\t"):
            # Continuation of multi-line value
            current_value_lines.append(line.strip())

    flush()
    return fm


def extract_description_from_frontmatter(fm: dict) -> str | None:
    """Return the 'description' field from frontmatter if present."""
    raw = fm.get("description") or fm.get("summary")
    if not raw:
        return None
    # Collapse whitespace/newlines from YAML block scalars.
    desc = " ".join(raw.split())
    return desc[:MAX_DESCRIPTION_CHARS].rstrip()


def extract_triggers_from_frontmatter(fm: dict) -> list[str]:
    """Return the 'triggers' list from frontmatter if present."""
    triggers = fm.get("triggers")
    if not triggers:
        return []
    if isinstance(triggers, list):
        return [t.strip() for t in triggers if t.strip()]
    # String — split on commas or newlines.
    return [t.strip() for t in re.split(r"[,\n]", triggers) if t.strip()]


def strip_frontmatter(text: str) -> str:
    """Remove YAML frontmatter block and return the rest."""
    return FRONTMATTER_RE.sub("", text, count=1).lstrip()


def extract_description_from_body(body: str) -> str | None:
    """
    Find the first useful description from the markdown body:
    1. <!-- SUMMARY ... END SUMMARY --> comment (first non-empty line)
    2. First paragraph after the H1 title
    3. First non-heading, non-empty line
    """
    # 1. SUMMARY comment
    m = SUMMARY_COMMENT_RE.search(body)
    if m:
        for line in m.group(1).splitlines():
            line = line.strip()
            if line and not line.startswith("Scope:") and not line.startswith("Not for:"):
                # Prefer "Scope:" line as a description fallback below
                pass
        # Actually, take the full first line of the SUMMARY block.
        for line in m.group(1).splitlines():
            line = line.strip()
            if line:
                return line[:MAX_DESCRIPTION_CHARS]

    lines = body.splitlines()
    after_title = False
    paragraph: list[str] = []

    for line in lines:
        stripped = line.strip()

        # Skip the H1 title line; start collecting after it.
        if not after_title:
            if stripped.startswith("# ") and not stripped.startswith("## "):
                after_title = True
            continue

        # Skip horizontal rules, HTML comments, blank lines at the start.
        if stripped.startswith("<!--") or stripped.startswith("---"):
            if paragraph:
                break
            continue

        # Headings signal the end of the intro paragraph.
        if stripped.startswith("#"):
            break

        if stripped:
            paragraph.append(stripped)
        else:
            if paragraph:
                break  # End of first paragraph.

    if paragraph:
        text = " ".join(paragraph)
        return text[:MAX_DESCRIPTION_CHARS].rstrip()

    # Fallback: first non-empty, non-heading line anywhere.
    for line in lines:
        s = line.strip()
        if s and not s.startswith("#") and not s.startswith("---") and not s.startswith("<!--"):
            return s[:MAX_DESCRIPTION_CHARS]

    return None


def extract_triggers_from_body(body: str) -> list[str]:
    """
    Scan the markdown body for a triggers section or inline trigger hints.
    Returns a list of trigger keyword strings.
    """
    lines = body.splitlines()
    triggers: list[str] = []
    in_trigger_section = False
    in_frontmatter = False

    for i, line in enumerate(lines):
        stripped = line.strip()

        # Skip frontmatter fences.
        if stripped == "---":
            in_frontmatter = not in_frontmatter
            continue
        if in_frontmatter:
            continue

        # Check for inline trigger pattern (e.g. "**Triggers:** foo, bar").
        for pat in INLINE_TRIGGER_PATTERNS:
            m = pat.match(stripped)
            if m:
                raw = m.group(1)
                triggers.extend(t.strip() for t in re.split(r"[,;]", raw) if t.strip())

        # Detect trigger section heading.
        for pat in TRIGGER_SECTION_PATTERNS:
            if pat.match(stripped):
                in_trigger_section = True
                break
        else:
            # Not a trigger section header — if we're IN a trigger section, collect items.
            if in_trigger_section:
                # A new heading or blank line after content ends the section.
                if stripped.startswith("#") or stripped.startswith("---"):
                    in_trigger_section = False
                    break
                # List items: "- foo" or "  - foo"
                list_match = re.match(r"^\s*[-*]\s+(.+)", line)
                if list_match:
                    item = list_match.group(1).strip().strip("`'\"")
                    if item:
                        triggers.append(item)
                # Non-empty, non-list lines that are short might still be comma-separated.
                elif stripped and len(stripped) < 120 and not stripped.startswith("<"):
                    # Might be continuation text; skip to avoid noise.
                    pass

    return triggers


def fallback_triggers_from_name(name: str) -> list[str]:
    """Use the skill name words as fallback trigger keywords."""
    words = re.split(r"[-_\s]+", name)
    return [w for w in words if len(w) > 2]


# ---------------------------------------------------------------------------
# Stub generation
# ---------------------------------------------------------------------------

def generate_stub(skill_name: str, source_path: Path) -> str:
    """Parse a skill file and return a compact stub string."""
    try:
        text = source_path.read_text(encoding="utf-8")
    except OSError as exc:
        raise RuntimeError(f"Cannot read {source_path}: {exc}") from exc

    with open(source_path) as f:
        lines = f.readlines()
    if len(lines) < 20:
        print(f"[ERROR] Source file {source_path} has only {len(lines)} lines (minimum 20). Refusing to generate stub from a stub.")
        sys.exit(1)

    fm = parse_frontmatter(text)
    body = strip_frontmatter(text)

    # --- Skill name (prefer frontmatter 'name', else file stem) ---
    display_name = fm.get("name") or skill_name
    # Title-case for readability if it looks like a slug.
    if "-" in display_name or "_" in display_name:
        display_name = display_name.replace("-", " ").replace("_", " ").title()

    # --- Description ---
    description = (
        extract_description_from_frontmatter(fm)
        or extract_description_from_body(body)
        or f"Skill: {display_name}"
    )
    # Truncate and clean up. Strip wrapping quotes that often come from
    # `<!-- SUMMARY "..." -->` source blocks.
    description = description.strip().strip('"').strip("'").strip().rstrip(".")
    if len(description) > MAX_DESCRIPTION_CHARS:
        description = description[:MAX_DESCRIPTION_CHARS - 3].rstrip() + "..."

    # --- Triggers ---
    triggers = (
        extract_triggers_from_frontmatter(fm)
        or extract_triggers_from_body(body)
        or fallback_triggers_from_name(skill_name)
    )
    # Deduplicate, preserving order.
    seen: set[str] = set()
    unique_triggers: list[str] = []
    for t in triggers:
        key = t.lower()
        if key not in seen:
            seen.add(key)
            unique_triggers.append(t)
    # Cap at 15 triggers to keep the stub compact.
    triggers_str = ", ".join(unique_triggers[:15])

    # --- Build stub ---
    # Wrap in YAML frontmatter so Claude Code's skill discovery picks it up.
    # Without `name:` and `description:` keys in frontmatter, the stub is invisible.
    # Description is escaped for YAML double-quoted-string rules.
    desc_yaml = description.replace("\\", "\\\\").replace('"', '\\"')

    stub = (
        "---\n"
        f"name: {skill_name}\n"
        f'description: "{desc_yaml}"\n'
        "---\n"
        "\n"
        f"# {display_name}\n"
        "\n"
        f"**Triggers:** {triggers_str}\n"
        f"**Full reference:** Read ~/dev/skill-hub/agents/general_skills/{skill_name}.md before using this skill.\n"
    )

    # Circular-reference guard: the stub's "Full reference" path must NOT resolve
    # to the same file as the stub output (which lives in ~/.claude/skills/<name>/SKILL.md).
    # The reference points to agents/general_skills/<name>.md (the full content),
    # and the stub is written to a DIFFERENT location by the caller.
    # We validate here that the reference path has real content (not itself a stub).
    reference_path = Path.home() / "dev" / "skill-hub" / "agents" / "general_skills" / f"{skill_name}.md"
    if reference_path.exists() and reference_path.stat().st_size < 500:
        print(f"[ERROR] Reference file looks like a stub ({reference_path.stat().st_size} bytes): {reference_path}")
        sys.exit(1)

    return stub


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def resolve_skill_names(names: list[str], source_dir: Path) -> list[str]:
    """Expand 'all' to every .md file in source_dir, otherwise validate names."""
    if names == ["all"]:
        files = sorted(source_dir.glob("*.md"))
        return [f.stem for f in files]

    resolved: list[str] = []
    for name in names:
        # Accept name with or without .md suffix.
        stem = name.removesuffix(".md")
        resolved.append(stem)
    return resolved


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Generate compact SKILL.md stubs for Claude Code skills.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap.dedent("""\
            Examples:
              %(prog)s all
              %(prog)s security-guardian api-design-pro
              %(prog)s all --output-dir ~/.claude/skills/
              %(prog)s all --source-dir ~/dev/skill-hub/agents/general_skills/
        """),
    )
    parser.add_argument(
        "skills",
        nargs="+",
        metavar="SKILL",
        help='Skill names (file stems, no .md) or "all" to process every skill.',
    )
    parser.add_argument(
        "--output-dir",
        default=str(DEFAULT_OUTPUT_DIR),
        metavar="DIR",
        help=f"Output directory for stubs (default: {DEFAULT_OUTPUT_DIR}).",
    )
    parser.add_argument(
        "--source-dir",
        default=str(DEFAULT_SOURCE_DIR),
        metavar="DIR",
        help=f"Directory containing full skill .md files (default: {DEFAULT_SOURCE_DIR}).",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print stubs to stdout instead of writing files.",
    )
    args = parser.parse_args()

    source_dir = Path(args.source_dir).expanduser().resolve()
    output_dir = Path(args.output_dir).expanduser().resolve()

    if not source_dir.is_dir():
        print(f"ERROR: source directory not found: {source_dir}", file=sys.stderr)
        sys.exit(1)

    skill_names = resolve_skill_names(args.skills, source_dir)

    if not skill_names:
        print("No skills found to process.", file=sys.stderr)
        sys.exit(1)

    processed = 0
    errors = 0
    bytes_saved_total = 0

    for name in skill_names:
        source_path = source_dir / f"{name}.md"
        if not source_path.exists():
            print(f"  SKIP  {name}  (file not found: {source_path})", file=sys.stderr)
            errors += 1
            continue

        try:
            stub_content = generate_stub(name, source_path)
        except RuntimeError as exc:
            print(f"  ERROR {name}: {exc}", file=sys.stderr)
            errors += 1
            continue

        original_bytes = source_path.stat().st_size
        stub_bytes = len(stub_content.encode("utf-8"))
        saved = original_bytes - stub_bytes
        bytes_saved_total += saved

        if args.dry_run:
            print(f"\n{'='*60}")
            print(f"STUB: {name}")
            print(f"{'='*60}")
            print(stub_content)
            print(f"[{stub_bytes} bytes vs {original_bytes} bytes original — saves {saved} bytes]")
        else:
            # 1. Write to legacy output dir (~/.claude/skills/<name>/SKILL.md)
            skill_output_dir = output_dir / name
            skill_output_dir.mkdir(parents=True, exist_ok=True)
            stub_path = skill_output_dir / "SKILL.md"
            stub_path.write_text(stub_content, encoding="utf-8")

            # 2. Also propagate to any skill-hub plugin that owns this skill —
            #    plugin stubs are what Claude Code actually loads.
            plugin_paths = find_plugin_stub_paths(name)
            for pp in plugin_paths:
                pp.write_text(stub_content, encoding="utf-8")

            plugin_note = f", +{len(plugin_paths)} plugin" if plugin_paths else ""
            print(f"  OK    {name}  ({stub_bytes} B stub / {original_bytes} B original, -{saved} B{plugin_note})")

        processed += 1

    # Summary
    print()
    print(f"Processed : {processed} skill(s)")
    if errors:
        print(f"Errors    : {errors}")
    if not args.dry_run:
        print(f"Output    : {output_dir}")
    print(f"Total saved: {bytes_saved_total:,} bytes  ({bytes_saved_total / 1024:.1f} KB)")
    if errors:
        sys.exit(1)


if __name__ == "__main__":
    main()
